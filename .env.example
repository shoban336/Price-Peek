# PricePeek Application Environment Variables

# Application
APP_NAME=PricePeek
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default zero-block SQLite fallback for development:
DATABASE_URL=sqlite:///./pricepeek.db
# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://pricepeek_user:secure_password@localhost:3306/pricepeek_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Platform Connector Engine Configuration
DEFAULT_PIN_CODE=560001
REQUEST_TIMEOUT_SECONDS=10
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
